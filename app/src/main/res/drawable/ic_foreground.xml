<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Adaptive foreground: Termux:Boot companion mark — a power glyph in the launcher's
         gradient stroke language, the same family as the Termux:API braces mark. Keep the mark
         inside the ~66dp safe zone so no mask (circle/squircle/rounded) clips the ring. The art
         is authored full-bleed in a 108 viewport, so scale it down about center. Keep in sync
         with non-adaptive ic_launcher.xml. -->
    <group
        android:name="mark"
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.56"
        android:scaleY="0.56">

        <!-- ring, open at the top -->
        <path
            android:pathData="M70.49,29.02 A33,33 0 1 1 35.51,29.02"
            android:strokeWidth="7.5"
            android:strokeLineCap="round"
            android:strokeLineJoin="round">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:type="linear"
                    android:startX="20" android:startY="18"
                    android:endX="88" android:endY="88">
                    <item android:offset="0" android:color="#13C8F5" />
                    <item android:offset="1" android:color="#05E27C" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- bar -->
        <path
            android:pathData="M53,16 L53,50"
            android:strokeWidth="7.5"
            android:strokeLineCap="round"
            android:strokeLineJoin="round">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:type="linear"
                    android:startX="20" android:startY="18"
                    android:endX="88" android:endY="88">
                    <item android:offset="0" android:color="#13C8F5" />
                    <item android:offset="1" android:color="#05E27C" />
                </gradient>
            </aapt:attr>
        </path>
    </group>
</vector>
